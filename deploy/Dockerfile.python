FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends -y curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system classroom \
    && useradd --system --gid classroom --create-home classroom

WORKDIR /app
COPY pyproject.toml ./
COPY backend ./backend
COPY worker ./worker
COPY agent ./agent
COPY scripts ./scripts
RUN python -m pip install --no-cache-dir .

FROM base AS runtime
RUN mkdir -p /app/logs /app/tmp && chown -R classroom:classroom /app
USER classroom

EXPOSE 8100
CMD ["python", "-m", "uvicorn", "--factory", "backend.app.main:create_app", "--host", "0.0.0.0", "--port", "8100"]

FROM base AS worker
RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir \
       --index-url https://download.pytorch.org/whl/cpu torch \
    && python -m pip install --no-cache-dir '.[worker]' \
    && mkdir -p /app/logs /app/tmp \
    && chown -R classroom:classroom /app
USER classroom

CMD ["python", "scripts/run_service_loop.py", "worker"]
