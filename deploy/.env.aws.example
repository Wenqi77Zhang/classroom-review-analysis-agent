# Copy to repository root as .env.production on the AWS host and chmod 600 it.
APP_ENV=production
PUBLIC_HOST=203-0-113-10.sslip.io
PUBLIC_PORT=3000
FRONTEND_ORIGIN=https://203-0-113-10.sslip.io
BACKEND_URL=http://backend:8100

POSTGRES_DB=classroom_review
POSTGRES_USER=classroom_review
POSTGRES_PASSWORD=replace-with-a-random-value
DATABASE_URL=postgresql+asyncpg://classroom_review:replace-with-the-same-random-value@postgres:5432/classroom_review

JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
PUBLIC_REGISTRATION_ENABLED=true
DEMO_ACCOUNT_PASSWORD=replace-with-at-least-16-random-characters
WORKER_SERVICE_TOKEN=replace-with-an-independent-random-value
AGENT_SERVICE_TOKEN=replace-with-a-different-random-value
TEAM_TUNNEL_ACCESS_CODE=replace-with-at-least-16-random-characters
TEAM_TUNNEL_INSTANCE_ID=aws-production

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_HOST=storage.203-0-113-10.sslip.io
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://storage.203-0-113-10.sslip.io
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=classroom-review-production
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-minio-root-user
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-at-least-32-random-characters
OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_RETENTION_DAYS=7
OBJECT_STORAGE_USE_PATH_STYLE=true

MODEL_PRIVACY_MODE=local
LOCAL_MODEL_CHAT_COMPLETIONS_URL=http://ollama:11434/v1/chat/completions
LOCAL_MODEL_NAME=qwen3.5:4b
LOCAL_MODEL_REASONING_EFFORT=none
# 免费规格 CPU 推理速度较慢；允许完整结构化响应生成后再由证据门禁校验。
LOCAL_MODEL_TIMEOUT_SECONDS=600
CLOUD_MODEL_CHAT_COMPLETIONS_URL=
CLOUD_MODEL_NAME=
CLOUD_MODEL_API_KEY=
TRANSLATION_PROVIDER=local_model
TRANSLATION_MODEL_CHAT_COMPLETIONS_URL=http://ollama:11434/v1/chat/completions
TRANSLATION_MODEL_NAME=qwen3.5:4b
TRANSLATION_TIMEOUT_SECONDS=300
TRANSLATION_BATCH_SIZE=8

WHISPER_MODEL=tiny
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_BACKOFF_SECONDS=30
AGENT_RUNNER_ID=agent-aws-1
AGENT_LEASE_SECONDS=600
AGENT_TRACE_PATH=logs/agent-traces.jsonl
