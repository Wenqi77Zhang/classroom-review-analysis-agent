# Copy to repository root as .env.production. Never commit the populated file.
APP_ENV=production
PUBLIC_PORT=3000
FRONTEND_ORIGIN=https://classroom-review.example.edu
BACKEND_URL=http://backend:8100

POSTGRES_DB=classroom_review
POSTGRES_USER=classroom_review
POSTGRES_PASSWORD=replace-with-a-random-value
DATABASE_URL=postgresql+asyncpg://classroom_review:replace-with-a-random-value@postgres:5432/classroom_review

JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
DEMO_ACCOUNT_PASSWORD=replace-with-at-least-16-random-characters
WORKER_SERVICE_TOKEN=replace-with-an-independent-random-value
AGENT_SERVICE_TOKEN=replace-with-a-different-random-value

OBJECT_STORAGE_PROVIDER=backblaze_b2
OBJECT_STORAGE_ENDPOINT=https://s3.example.backblazeb2.com
OBJECT_STORAGE_REGION=replace-with-b2-region
OBJECT_STORAGE_BUCKET=replace-with-private-bucket
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-restricted-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-restricted-application-key
OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_RETENTION_DAYS=7
OBJECT_STORAGE_USE_PATH_STYLE=false

# Public deployments should set a strong entrance code even when the demo
# teacher account is enabled. The value is hashed before it enters a cookie.
TEAM_TUNNEL_ACCESS_CODE=replace-with-at-least-16-random-characters
TEAM_TUNNEL_INSTANCE_ID=production
# Required only for the stable named-tunnel profile. Keep this secret out of Git.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-remotely-managed-tunnel-token

# Choose one real provider path. Private classroom material should not be sent
# to a cloud model unless the teacher explicitly selects cloud processing.
MODEL_PRIVACY_MODE=cloud
LOCAL_MODEL_CHAT_COMPLETIONS_URL=
LOCAL_MODEL_NAME=
LOCAL_MODEL_REASONING_EFFORT=none
CLOUD_MODEL_CHAT_COMPLETIONS_URL=https://replace-with-openai-compatible-endpoint/v1/chat/completions
CLOUD_MODEL_NAME=replace-with-model-name
CLOUD_MODEL_API_KEY=replace-with-provider-key
TRANSLATION_PROVIDER=disabled
TRANSLATION_MODEL_CHAT_COMPLETIONS_URL=
TRANSLATION_MODEL_NAME=
TRANSLATION_TIMEOUT_SECONDS=120
TRANSLATION_BATCH_SIZE=8

WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_BACKOFF_SECONDS=30
AGENT_RUNNER_ID=agent-production-1
AGENT_LEASE_SECONDS=300
AGENT_TRACE_PATH=logs/agent-traces.jsonl
