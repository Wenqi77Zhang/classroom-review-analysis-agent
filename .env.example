# Runtime
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
# 后端使用异步驱动，格式：postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DATABASE_URL=
POSTGRES_DB=classroom_review
POSTGRES_USER=classroom_review
POSTGRES_PASSWORD=

# Authentication
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 演示账号口令，由本地配置提供；不得硬编码进代码或提交真实值。
DEMO_ACCOUNT_PASSWORD=

# Internal service auth
# Worker 与 Agent 回写任务状态、逐字稿和结论时使用的服务令牌；与教师 JWT 分开，
# 因为它不属于任何教师账号，且不应能读取业务数据。
WORKER_SERVICE_TOKEN=

# Object storage (S3-compatible)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# MinIO 等自托管服务必须使用 path-style 寻址；云厂商 S3 一般设为 false。
OBJECT_STORAGE_USE_PATH_STYLE=true
# 预签名 URL 有效期；限时是 docs/data-security.md 的强制要求。
PRESIGN_EXPIRE_SECONDS=900

# Model routing
MODEL_PRIVACY_MODE=local
CLOUD_MODEL_API_KEY=
LOCAL_MODEL_BASE_URL=

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
