# Runtime
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=
POSTGRES_DB=classroom_review
POSTGRES_USER=classroom_review
POSTGRES_PASSWORD=

# Authentication
JWT_SECRET=

# Object storage
# M1 default: Backblaze B2 through its S3-compatible API.
# Keep the generic names below so another S3-compatible provider can replace B2
# without changing the frontend, database schema, or Worker pipeline.
OBJECT_STORAGE_PROVIDER=backblaze_b2
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_RETENTION_DAYS=7

# Model routing
MODEL_PRIVACY_MODE=local
CLOUD_MODEL_API_KEY=
LOCAL_MODEL_BASE_URL=

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
