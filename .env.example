# Runtime
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
# 与常见的其他本地项目错开；start 脚本会据此统一设置后端、Worker、Agent 和前端 BFF。
BACKEND_PORT=8100
BACKEND_URL=http://127.0.0.1:8100

# Database
# 后端使用异步驱动，格式：postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DATABASE_URL=
POSTGRES_DB=classroom_review
POSTGRES_USER=classroom_review
POSTGRES_PASSWORD=

# Authentication
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 演示账号口令，由本地配置提供；不得硬编码进代码或提交真实值。
DEMO_ACCOUNT_PASSWORD=

# Internal service auth
# Worker 与 Agent 回写时使用的服务令牌，与教师 JWT 分开——它们不属于任何教师账号，
# 也不应能读取业务数据。两者必须使用不同的值：共用一个令牌会让 Agent 能覆盖逐字稿、
# Worker 能写入教学结论，违反最小权限。端点与身份的对应关系见
# backend/app/schemas/task.py 的 INTERNAL_ENDPOINT_SCOPES。
WORKER_SERVICE_TOKEN=
AGENT_SERVICE_TOKEN=

# Object storage
# M1 default: Backblaze B2 through its S3-compatible API.
# Keep the generic names below so another S3-compatible provider can replace B2
# without changing the frontend, database schema, or Worker pipeline.
OBJECT_STORAGE_PROVIDER=backblaze_b2
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# 预签名 URL 有效期；限时是 docs/product-and-technology-handbook.md 的强制要求。
OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_RETENTION_DAYS=7
# 寻址方式：B2 的 S3 API 用 virtual-host 风格，保持 false。
# 仅当改用本地 MinIO 替代（docker compose 的 local-infra profile）时才设为 true。
OBJECT_STORAGE_USE_PATH_STYLE=false

# Model routing
MODEL_PRIVACY_MODE=local
CLOUD_MODEL_API_KEY=
# OpenAI-compatible chat completions endpoint；私有课堂的本地地址必须是 loopback。
LOCAL_MODEL_CHAT_COMPLETIONS_URL=http://127.0.0.1:11434/v1/chat/completions
LOCAL_MODEL_NAME=qwen3.5:4b
# Qwen thinking 默认开启；结构化分析关闭 thinking，避免只返回推理而没有最终 JSON。
LOCAL_MODEL_REASONING_EFFORT=none
# Worker 自动翻译默认复用上面的本地 Ollama 模型；空的 endpoint/model 表示继承。
# 设为 none/disabled 可关闭自动翻译，但双语课堂随后必须由教师补充 SRT/VTT。
TRANSLATION_PROVIDER=local_model
TRANSLATION_MODEL_CHAT_COMPLETIONS_URL=
TRANSLATION_MODEL_NAME=
TRANSLATION_TIMEOUT_SECONDS=120
TRANSLATION_BATCH_SIZE=8
# 云模型只允许 HTTPS；公开课堂明确选择 cloud 时才会使用。
CLOUD_MODEL_CHAT_COMPLETIONS_URL=
CLOUD_MODEL_NAME=

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_BACKOFF_SECONDS=30

# Agent
AGENT_RUNNER_ID=agent-local-1
AGENT_LEASE_SECONDS=300
# 仅保存脱敏结构化事件；logs/ 已被 .gitignore 排除。
AGENT_TRACE_PATH=logs/agent-traces.jsonl
