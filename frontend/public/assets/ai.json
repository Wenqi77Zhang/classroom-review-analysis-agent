    {
      "index": 35,
      "start_ms": 57000,
      "end_ms": 60640,
      "speaker": null,
      "text": "得入普克等比賽中 擊敗人類頂級選手",
      "translation": null
    },
    {
      "index": 36,
      "start_ms": 61840,
      "end_ms": 65160,
      "speaker": null,
      "text": "除此之外 人工智能在其他方面的研究",
      "translation": null
    },
    {
      "index": 37,
      "start_ms": 65160,
      "end_ms": 69760,
      "speaker": null,
      "text": "如自動駕駛 機器人 機器翻譯 頭像識別等領域",
      "translation": null
    },
    {
      "index": 38,
      "start_ms": 69760,
      "end_ms": 71600,
      "speaker": null,
      "text": "也取得了封鎖的成果",
      "translation": null
    },
    {
      "index": 39,
      "start_ms": 73000,
      "end_ms": 75280,
      "speaker": null,
      "text": "我們大家來一起看兩段視頻",
      "translation": null
    },
    {
      "index": 40,
      "start_ms": 75960,
      "end_ms": 78160,
      "speaker": null,
      "text": "第一段視頻是谷歌奇下的",
      "translation": null
    },
    {
      "index": 41,
      "start_ms": 78160,
      "end_ms": 80000,
      "speaker": null,
      "text": "Google X實驗室研發的",
      "translation": null
    },
    {
      "index": 42,
      "start_ms": 80000,
      "end_ms": 82440,
      "speaker": null,
      "text": "全自動駕駛企車的公路研視",
      "translation": null
    },
    {
      "index": 43,
      "start_ms": 82440,
      "end_ms": 89440,
      "speaker": null,
      "text": "這樣的無人價是汽車,不需要價值者就能啟動,行使以及停止。",
      "translation": null
    },
    {
      "index": 44,
      "start_ms": 89440,
      "end_ms": 94440,
      "speaker": null,
      "text": "在封閉的場地,無人價實已經完全可以實現。",
      "translation": null
    },
    {
      "index": 45,
      "start_ms": 94440,
      "end_ms": 99440,
      "speaker": null,
      "text": "不久的將來,這樣的無人價是汽車將會變不大街小像。",
      "translation": null
    },
    {
      "index": 46,
      "start_ms": 99440,
      "end_ms": 105440,
      "speaker": null,
      "text": "第二段,是2017年,由美國博士頓動理公司發布的視頻。",
      "translation": null
    },
    {
      "index": 47,
      "start_ms": 105440,
      "end_ms": 110440,
      "speaker": null,
      "text": "大家看到的這個機器人稱為Atlas",
      "translation": null
    },
    {
      "index": 48,
      "start_ms": 110440,
      "end_ms": 114440,
      "speaker": null,
      "text": "他不但完成了完美的362的後空翻動作",
      "translation": null
    },
    {
      "index": 49,
      "start_ms": 114440,
      "end_ms": 117440,
      "speaker": null,
      "text": "甚至還舉起雙手做出慶祝",
      "translation": null
    },
    {
      "index": 50,
      "start_ms": 117440,
      "end_ms": 120440,
      "speaker": null,
      "text": "大家知道後空翻這個動作",
      "translation": null
    },
    {
      "index": 51,
      "start_ms": 120440,
      "end_ms": 124440,
      "speaker": null,
      "text": "是大部分人類都來一做到的高藍動作",
      "translation": null
    },
    {
      "index": 52,
      "start_ms": 124440,
      "end_ms": 126440,
      "speaker": null,
      "text": "更口礦是機器人",
      "translation": null
    },
    {
      "index": 53,
      "start_ms": 126440,
      "end_ms": 130440,
      "speaker": null,
      "text": "所以Atlas屏美專業運動員",
      "translation": null
    },
    {
      "index": 54,
      "start_ms": 130440,
      "end_ms": 132440,
      "speaker": null,
      "text": "這一次突破",
      "translation": null
    },
    {
      "index": 55,
      "start_ms": 132440,
      "end_ms": 136520,
      "speaker": null,
      "text": "讓我們看到了機器人在未來的無限可能",
      "translation": null
    },
    {
      "index": 56,
      "start_ms": 136520,
      "end_ms": 140280,
      "speaker": null,
      "text": "這些成果無意讓人工智能舉世主目",
      "translation": null
    },
    {
      "index": 57,
      "start_ms": 140280,
      "end_ms": 142200,
      "speaker": null,
      "text": "當之無愧成為新一代",
      "translation": null
    },
    {
      "index": 58,
      "start_ms": 142200,
      "end_ms": 144520,
      "speaker": null,
      "text": "細細技術領域的核心",
      "translation": null
    },
    {
      "index": 59,
      "start_ms": 144520,
      "end_ms": 147520,
      "speaker": null,
      "text": "當前世界主要發達國家",
      "translation": null
    },
    {
      "index": 60,
      "start_ms": 147520,
      "end_ms": 151080,
      "speaker": null,
      "text": "都將人工智能作為目前最大的發展戰略",
      "translation": null
    },
    {
      "index": 61,
      "start_ms": 151080,
      "end_ms": 155200,
      "speaker": null,
      "text": "立陀在新一輪的國際盡重中掌握主導權",
      "translation": null
    },
    {
      "index": 62,
      "start_ms": 155200,
      "end_ms": 157160,
      "speaker": null,
      "text": "2017年9月1日",
      "translation": null
    },
    {
      "index": 63,
      "start_ms": 157160,
      "end_ms": 160080,
      "speaker": null,
      "text": "普京在開學日演講中提出",
      "translation": null
    },
    {
      "index": 64,
      "start_ms": 160080,
      "end_ms": 163080,
      "speaker": null,
      "text": "未來誰率先掌握人工智能",
      "translation": null
    },
    {
      "index": 65,
      "start_ms": 163080,
      "end_ms": 165080,
      "speaker": null,
      "text": "誰就能稱霸世界",
      "translation": null
    },
    {
      "index": 66,
      "start_ms": 165080,
      "end_ms": 168080,
      "speaker": null,
      "text": "2018年4月25日",
      "translation": null
    },
    {
      "index": 67,
      "start_ms": 168080,
      "end_ms": 170080,
      "speaker": null,
      "text": "奧盟委員會計劃",
      "translation": null
    },
    {
      "index": 68,
      "start_ms": 170080,
      "end_ms": 173080,
      "speaker": null,
      "text": "2018至2020年在人工智能領域投資",
      "translation": null
    },
    {
      "index": 69,
      "start_ms": 173080,
      "end_ms": 175080,
      "speaker": null,
      "text": "240億美元",
      "translation": null
    },
    {
      "index": 70,
      "start_ms": 175080,
      "end_ms": 179080,
      "speaker": null,
      "text": "投年5月美國白宮組織研討會",
      "translation": null
    },
    {
      "index": 71,
      "start_ms": 179080,
      "end_ms": 182080,
      "speaker": null,
      "text": "成立人工智能專門委員會",
      "translation": null
    },
    {
      "index": 72,
      "start_ms": 182080,
      "end_ms": 184080,
      "speaker": null,
      "text": "確保人工智能領域",
      "translation": null
    },
    {
      "index": 73,
      "start_ms": 184080,
      "end_ms": 186080,
      "speaker": null,
      "text": "美國第一",
      "translation": null
    },
    {
      "index": 74,
      "start_ms": 186080,
      "end_ms": 189080,
      "speaker": null,
      "text": "中國國委員2017年7月8日",
      "translation": null
    },
    {
      "index": 75,
      "start_ms": 189080,
      "end_ms": 192560,
      "speaker": null,
      "text": "第8日 立法了新一代人工智能发展规划",
      "translation": null
    },
    {
      "index": 76,
      "start_ms": 192560,
      "end_ms": 195480,
      "speaker": null,
      "text": "明確提出了中国新一代人工智能",
      "translation": null
    },
    {
      "index": 77,
      "start_ms": 195480,
      "end_ms": 197840,
      "speaker": null,
      "text": "实现三部走的发展战略",
      "translation": null
    },
    {
      "index": 78,
      "start_ms": 198840,
      "end_ms": 203480,
      "speaker": null,
      "text": "可以用六个字对中国人工智能三部走战略做的总结",
      "translation": null
    },
    {
      "index": 79,
      "start_ms": 203480,
      "end_ms": 207760,
      "speaker": null,
      "text": "记 彤部 突破 领先",
      "translation": null
    },
    {
      "index": 80,
      "start_ms": 207760,
      "end_ms": 212320,
      "speaker": null,
      "text": "到2020年 中国人工智能总体技术和应用",
      "translation": null
    },
    {
      "index": 81,
      "start_ms": 212320,
      "end_ms": 215120,
      "speaker": null,
      "text": "与世界先进水平要彤部",
      "translation": null
    },
    {
      "index": 82,
      "start_ms": 215120,
      "end_ms": 218400,
      "speaker": null,
      "text": "到2020年 中国人工智能提出",
      "translation": null
    },
    {
      "index": 83,
      "start_ms": 218400,
      "end_ms": 222400,
      "speaker": null,
      "text": "在中國人工智能發展報告中了解到",
      "translation": null
    },
    {
      "index": 84,
      "start_ms": 222400,
      "end_ms": 224400,
      "speaker": null,
      "text": "目前中國人工智能的發展",
      "translation": null
    },
    {
      "index": 85,
      "start_ms": 224400,
      "end_ms": 227400,
      "speaker": null,
      "text": "雖然具備了非常優又的條件",
      "translation": null
    },
    {
      "index": 86,
      "start_ms": 227400,
      "end_ms": 230400,
      "speaker": null,
