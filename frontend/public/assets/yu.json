{
  "source_language": "zh",
  "translation_language": null,
  "duration_ms": 415266,
  "segments": [
    {
      "index": 0,
      "start_ms": 0,
      "end_ms": 12000,
      "speaker": null,
      "text": "人們長巴眼淚與女人相提病論",
      "translation": null
    },
    {
      "index": 1,
      "start_ms": 12000,
      "end_ms": 15000,
      "speaker": null,
      "text": "一詞表明女人的柔弱",
      "translation": null
    },
    {
      "index": 2,
      "start_ms": 15000,
      "end_ms": 19000,
      "speaker": null,
      "text": "其實有淚不一定是不一定的",
      "translation": null
    },
    {
      "index": 3,
      "start_ms": 19000,
      "end_ms": 22000,
      "speaker": null,
      "text": "不一定是不一定的",
      "translation": null
    },
    {
      "index": 4,
      "start_ms": 22000,
      "end_ms": 23000,
      "speaker": null,
      "text": "不一定是不一定的",
      "translation": null
    },
    {
      "index": 5,
      "start_ms": 23000,
      "end_ms": 25000,
      "speaker": null,
      "text": "不一定是不一定的",
      "translation": null
    },
    {
      "index": 6,
      "start_ms": 25000,
      "end_ms": 27000,
      "speaker": null,
      "text": "不一定是不一定的",
      "translation": null
    },
    {
      "index": 7,
      "start_ms": 27000,
      "end_ms": 30000,
      "speaker": null,
      "text": "其时有类不一定软弱",
      "translation": null
    },
    {
      "index": 8,
      "start_ms": 30000,
      "end_ms": 33000,
      "speaker": null,
      "text": "无类也未必意味着经强",
      "translation": null
    },
    {
      "index": 9,
      "start_ms": 33000,
      "end_ms": 36000,
      "speaker": null,
      "text": "特别是对于一个母亲来说",
      "translation": null
    },
    {
      "index": 10,
      "start_ms": 36000,
      "end_ms": 39000,
      "speaker": null,
      "text": "这类水中运含着更多的内容",
      "translation": null
    },
    {
      "index": 11,
      "start_ms": 39000,
      "end_ms": 42000,
      "speaker": null,
      "text": "在老舍心致的散闻",
      "translation": null
    },
    {
      "index": 12,
      "start_ms": 42000,
      "end_ms": 43000,
      "speaker": null,
      "text": "我的母亲中",
      "translation": null
    },
    {
      "index": 13,
      "start_ms": 43000,
      "end_ms": 46000,
      "speaker": null,
      "text": "母亲和我的几次流类",
      "translation": null
    },
    {
      "index": 14,
      "start_ms": 46000,
      "end_ms": 48000,
      "speaker": null,
      "text": "就含着痛",
      "translation": null
    },
    {
      "index": 15,
      "start_ms": 48000,
      "end_ms": 49000,
      "speaker": null,
      "text": "带着毁",
      "translation": null
    },
    {
      "index": 16,
      "start_ms": 49000,
      "end_ms": 51000,
      "speaker": null,
      "text": "满怀生情",
      "translation": null
    },
    {
      "index": 17,
      "start_ms": 51000,
      "end_ms": 53000,
      "speaker": null,
      "text": "引人生私",
      "translation": null
    },
    {
      "index": 18,
      "start_ms": 57000,
      "end_ms": 62000,
      "speaker": null,
      "text": "若雪要將十元的保證金",
      "translation": null
    },
    {
      "index": 19,
      "start_ms": 62000,
      "end_ms": 64000,
      "speaker": null,
      "text": "這是一筆劇款",
      "translation": null
    },
    {
      "index": 20,
      "start_ms": 64000,
      "end_ms": 67000,
      "speaker": null,
      "text": "母親做了半個月的難",
      "translation": null
    },
    {
      "index": 21,
      "start_ms": 67000,
      "end_ms": 69000,
      "speaker": null,
      "text": "把這劇款抽到",
      "translation": null
    },
    {
      "index": 22,
      "start_ms": 69000,
      "end_ms": 73000,
      "speaker": null,
      "text": "而後寒淚把我送出門去",
      "translation": null
    },
    {
      "index": 23,
      "start_ms": 73000,
      "end_ms": 75000,
      "speaker": null,
      "text": "此時的類",
      "translation": null
    },
    {
      "index": 24,
      "start_ms": 75000,
      "end_ms": 78000,
      "speaker": null,
      "text": "保寒這詞母對老兒子",
      "translation": null
    },
    {
      "index": 25,
      "start_ms": 78000,
      "end_ms": 80000,
      "speaker": null,
      "text": "出此離家的依脸",
      "translation": null
    },
    {
      "index": 26,
      "start_ms": 80000,
      "end_ms": 82000,
      "speaker": null,
      "text": "同時更嚴厲著一位",
      "translation": null
    },
    {
      "index": 27,
      "start_ms": 82000,
      "end_ms": 85000,
      "speaker": null,
      "text": "坑胃兒女犧牲一切的詞母",
      "translation": null
    },
    {
      "index": 28,
      "start_ms": 85000,
      "end_ms": 88000,
      "speaker": null,
      "text": "對兒子未來人生的欺騙",
      "translation": null
    },
    {
      "index": 29,
      "start_ms": 89000,
      "end_ms": 92000,
      "speaker": null,
      "text": "當我有失犯畢業",
      "translation": null
    },
    {
      "index": 30,
      "start_ms": 92000,
      "end_ms": 94000,
      "speaker": null,
      "text": "而被派為小訊小校長",
      "translation": null
    },
    {
      "index": 31,
      "start_ms": 95000,
      "end_ms": 99000,
      "speaker": null,
      "text": "母親與我都一夜不曾合演",
      "translation": null
    },
    {
      "index": 32,
      "start_ms": 99000,
      "end_ms": 102000,
      "speaker": null,
      "text": "我只說了句以後",
      "translation": null
    },
    {
      "index": 33,
      "start_ms": 102000,
      "end_ms": 105000,
      "speaker": null,
      "text": "您可以攜一攜了",
      "translation": null
    },
    {
      "index": 34,
      "start_ms": 106000,
      "end_ms": 111000,
      "speaker": null,
      "text": "他的回答只要以川川的眼淚",
      "translation": null
    },
    {
      "index": 35,
      "start_ms": 111000,
      "end_ms": 116660,
      "speaker": null,
      "text": "母親用喜悅與心味的類水揮硬了我",
      "translation": null
    },
    {
      "index": 36,
      "start_ms": 116660,
      "end_ms": 118920,
      "speaker": null,
      "text": "母親最大的喜悅",
      "translation": null
    },
    {
      "index": 37,
      "start_ms": 118920,
      "end_ms": 121920,
      "speaker": null,
      "text": "莫過於見到兒女長大成臺",
      "translation": null
    },
    {
      "index": 38,
      "start_ms": 121920,
      "end_ms": 126280,
      "speaker": null,
      "text": "更何況 老舌的母親是在立進了摩奈奮",
      "translation": null
    },
    {
      "index": 39,
      "start_ms": 126280,
      "end_ms": 128120,
      "speaker": null,
      "text": "太如願意長的呢",
      "translation": null
    },
    {
      "index": 40,
      "start_ms": 128120,
      "end_ms": 133320,
      "speaker": null,
      "text": "母親要我結了婚 我不要",
      "translation": null
    },
    {
      "index": 41,
      "start_ms": 133320,
      "end_ms": 136280,
      "speaker": null,
      "text": "我請來三姐給我說情",
      "translation": null
    },
    {
      "index": 42,
      "start_ms": 136280,
      "end_ms": 139880,
      "speaker": null,
      "text": "老母含累 電了頭",
      "translation": null
    },
    {
      "index": 43,
      "start_ms": 141000,
      "end_ms": 144680,
      "speaker": null,
      "text": "母親 迅說兒子 反昆成家",
      "translation": null
    },
    {
      "index": 44,
      "start_ms": 144680,
      "end_ms": 147320,
      "speaker": null,
      "text": "但兒子做了為你的選擇",
      "translation": null
    },
    {
      "index": 45,
      "start_ms": 147320,
      "end_ms": 150080,
      "speaker": null,
      "text": "這怎能不叫詞母痛心",
      "translation": null
    },
    {
      "index": 46,
      "start_ms": 150080,
      "end_ms": 152120,
      "speaker": null,
      "text": "這含累的電頭",
      "translation": null
    },
    {
      "index": 47,
      "start_ms": 152120,
      "end_ms": 155000,
      "speaker": null,
      "text": "顯露了詞母 寬擴的胸懷",
      "translation": null
    },
    {
      "index": 48,
      "start_ms": 155000,
      "end_ms": 158360,
      "speaker": null,
      "text": "說明了他對兒子選擇的理解",
      "translation": null
    },
    {
      "index": 49,
      "start_ms": 158360,
      "end_ms": 162000,
      "speaker": null,
      "text": "農縮了詞母的犧牲進身",
      "translation": null
    },
    {
      "index": 50,
      "start_ms": 163000,
      "end_ms": 164800,
      "speaker": null,
      "text": "這經孔",
      "translation": null
    },
    {
      "index": 51,
      "start_ms": 164800,
      "end_ms": 166600,
      "speaker": null,
      "text": "這竟章",
      "translation": null
    },
    {
      "index": 52,
      "start_ms": 166600,
      "end_ms": 169760,
      "speaker": null,
      "text": "在家上一家隱私的策劃",
      "translation": null
    },
    {
      "index": 53,
      "start_ms": 169760,
      "end_ms": 172080,
      "speaker": null,
      "text": "而你安全的故力",
      "translation": null
    },
    {
      "index": 54,
      "start_ms": 172080,
      "end_ms": 174880,
      "speaker": null,
      "text": "起事一根软弱的老寡夫",
      "translation": null
    },
    {
      "index": 55,
      "start_ms": 174880,
      "end_ms": 176880,
      "speaker": null,
      "text": "所能受的期待",
      "translation": null
    },
    {
      "index": 56,
      "start_ms": 177880,
      "end_ms": 180200,
      "speaker": null,
      "text": "可是在这种时候",
      "translation": null
    },
    {
      "index": 57,
      "start_ms": 180200,
      "end_ms": 183160,
      "speaker": null,
      "text": "母亲的心很起来",
      "translation": null
    },
    {
      "index": 58,
      "start_ms": 183160,
      "end_ms": 186360,
      "speaker": null,
      "text": "他不荒不虎",
      "translation": null
    },
    {
      "index": 59,
      "start_ms": 186360,
      "end_ms": 190480,
      "speaker": null,
      "text": "要从无办法中想出办法来",
      "translation": null
    },
    {
      "index": 60,
      "start_ms": 190480,
      "end_ms": 194400,
      "speaker": null,
      "text": "他的内汇网心中落",
      "translation": null
    },
    {
      "index": 61,
      "start_ms": 196000,
      "end_ms": 198000,
      "speaker": null,
      "text": "他真差证",
      "translation": null
    },
    {
      "index": 62,
      "start_ms": 198000,
      "end_ms": 201680,
      "speaker": null,
      "text": "要這次一臣 手膚著門況",
      "translation": null
    },
    {
      "index": 63,
      "start_ms": 201680,
      "end_ms": 205440,
      "speaker": null,
      "text": "砍花腳許許的掛曲",
      "translation": null
    },
    {
      "index": 64,
      "start_ms": 207680,
      "end_ms": 209000,
      "speaker": null,
      "text": "苦心",
      "translation": null
    },
    {
      "index": 65,
      "start_ms": 209280,
      "end_ms": 211760,
      "speaker": null,
      "text": "我清爛兩小時的醬",
      "translation": null
    },
    {
      "index": 66,
      "start_ms": 212080,
      "end_ms": 214560,
      "speaker": null,
      "text": "要用幾部看的機市",
      "translation": null
    },
    {
      "index": 67,
      "start_ms": 214560,
      "end_ms": 217440,
      "speaker": null,
      "text": "回到青奪冷暴的家中",
      "translation": null
    },
    {
      "index": 68,
      "start_ms": 217760,
      "end_ms": 220000,
      "speaker": null,
      "text": "母親笑了",
      "translation": null
    },
    {
      "index": 69,
      "start_ms": 220560,
      "end_ms": 222240,
      "speaker": null,
      "text": "即知聽說",
      "translation": null
    },
    {
      "index": 70,
      "start_ms": 222240,
      "end_ms": 225440,
      "speaker": null,
      "text": "我海虛回向他認住了",
      "translation": null
    },
    {
      "index": 71,
      "start_ms": 225440,
      "end_ms": 230440,
      "speaker": null,
      "text": "半天他在汉粗一口氣來",
      "translation": null
    },
    {
      "index": 72,
      "start_ms": 230440,
      "end_ms": 232440,
      "speaker": null,
      "text": "到我該走的時候",
      "translation": null
    },
    {
      "index": 73,
      "start_ms": 232440,
      "end_ms": 235440,
      "speaker": null,
      "text": "他第一個我一些花生",
      "translation": null
    },
    {
      "index": 74,
      "start_ms": 235440,
      "end_ms": 238440,
      "speaker": null,
      "text": "去怕腳子",
      "translation": null
    },
    {
      "index": 75,
      "start_ms": 238440,
      "end_ms": 240440,
      "speaker": null,
      "text": "占火分飛",
      "translation": null
    },
    {
      "index": 76,
      "start_ms": 240440,
      "end_ms": 243440,
      "speaker": null,
      "text": "母親懂得類是沒有用的",
      "translation": null
    },
    {
      "index": 77,
      "start_ms": 243440,
      "end_ms": 245440,
      "speaker": null,
      "text": "只能把心恆起來",
      "translation": null
    },
    {
      "index": 78,
      "start_ms": 245440,
      "end_ms": 247440,
      "speaker": null,
      "text": "堅強面對生活",
      "translation": null
    },
    {
      "index": 79,
      "start_ms": 247440,
      "end_ms": 250440,
      "speaker": null,
      "text": "讓類流入心中",
      "translation": null
    },
    {
      "index": 80,
      "start_ms": 250440,
      "end_ms": 251440,
      "speaker": null,
      "text": "三解出駕駛",
      "translation": null
    },
    {
      "index": 81,
      "start_ms": 251440,
      "end_ms": 254440,
      "speaker": null,
      "text": "母親痛的就像歌調自己的右手",
      "translation": null
    },
    {
      "index": 82,
      "start_ms": 254440,
      "end_ms": 263160,
      "speaker": null,
      "text": "用手, 但是他增窄著看著花叫走去, 累在心中決定。",
      "translation": null
    },
    {
      "index": 83,
      "start_ms": 263160,
      "end_ms": 274960,
      "speaker": null,
      "text": "除心之夜, 中日沒人跟他說一句話的母親, 去要在這熱鬧飛繁,親人團聚聚業, 孤獨的過著欺惨的除心。",
      "translation": null
    },
    {
      "index": 84,
      "start_ms": 274960,
      "end_ms": 278280,
      "speaker": null,
      "text": "沒有類 只有去把小子",
      "translation": null
    },
    {
      "index": 85,
      "start_ms": 279000,
      "end_ms": 283640,
      "speaker": null,
      "text": "類水如心水 再心中進進流湯",
      "translation": null
    },
    {
      "index": 86,
      "start_ms": 284200,
      "end_ms": 287960,
      "speaker": null,
      "text": "母親 異生的痛 悄悄著老舌的心",
      "translation": null
    },
    {
      "index": 87,
      "start_ms": 288520,
      "end_ms": 291080,
      "speaker": null,
      "text": "他多麼想回報母親的身恩",
      "translation": null
    },
    {
      "index": 88,
      "start_ms": 291440,
      "end_ms": 295440,
      "speaker": null,
      "text": "多麼想給苦痛異生的母親一個幸福的晚年",
      "translation": null
    },
    {
      "index": 89,
      "start_ms": 296000,
      "end_ms": 299240,
      "speaker": null,
      "text": "但時代是他成為孕子",
      "translation": null
    },
    {
      "index": 90,
      "start_ms": 300440,
      "end_ms": 304440,
      "speaker": null,
      "text": "1924年 老舌踏上了開啟英國的品種",
      "translation": null
    },
    {
      "index": 91,
      "start_ms": 304440,
      "end_ms": 307180,
      "speaker": null,
      "text": "離開了65歲的老母",
      "translation": null
    },
    {
      "index": 92,
      "start_ms": 307180,
      "end_ms": 310040,
      "speaker": null,
      "text": "1929年歸國後不久",
      "translation": null
    },
    {
      "index": 93,
      "start_ms": 310040,
      "end_ms": 313320,
      "speaker": null,
      "text": "他先後到山東吉南祈魯大學",
      "translation": null
    },
    {
      "index": 94,
      "start_ms": 313320,
      "end_ms": 315860,
      "speaker": null,
      "text": "和清島山東大學認教",
      "translation": null
    },
    {
      "index": 95,
      "start_ms": 315860,
      "end_ms": 317820,
      "speaker": null,
      "text": "至1936年",
      "translation": null
    },
    {
      "index": 96,
      "start_ms": 317820,
      "end_ms": 321160,
      "speaker": null,
      "text": "1937年他又離開母親",
      "translation": null
    },
    {
      "index": 97,
      "start_ms": 321160,
      "end_ms": 323060,
      "speaker": null,
      "text": "來到了大西南",
      "translation": null
    },
    {
      "index": 98,
      "start_ms": 325560,
      "end_ms": 328480,
      "speaker": null,
      "text": "截上是那麼熱鬧",
      "translation": null
    },
    {
      "index": 99,
      "start_ms": 328480,
      "end_ms": 331640,
      "speaker": null,
      "text": "我去什麼也沒看見",
      "translation": null
    },
    {
      "index": 100,
      "start_ms": 331640,
      "end_ms": 334640,
      "speaker": null,
      "text": "內折迷的我的眼",
      "translation": null
    },
    {
      "index": 101,
      "start_ms": 335640,
      "end_ms": 341640,
      "speaker": null,
      "text": "今天內又折住了我的眼",
      "translation": null
    },
    {
      "index": 102,
      "start_ms": 341640,
      "end_ms": 347640,
      "speaker": null,
      "text": "有相繼當日孤獨的過難期盡的初期的服務",
      "translation": null
    },
    {
      "index": 103,
      "start_ms": 347640,
      "end_ms": 353640,
      "speaker": null,
      "text": "可是服務不會再後盼著我了",
      "translation": null
    },
    {
      "index": 104,
      "start_ms": 353640,
      "end_ms": 358640,
      "speaker": null,
      "text": "他以入了頭",
      "translation": null
    },
    {
      "index": 105,
      "start_ms": 358640,
      "end_ms": 364240,
      "speaker": null,
      "text": "大街上的熱鬧 创脫出我的孤獨與配商",
      "translation": null
    },
    {
      "index": 106,
      "start_ms": 364240,
      "end_ms": 368040,
      "speaker": null,
